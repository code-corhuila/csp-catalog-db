# Names of the variables read by deploy/compose.yml. Copy to .env and fill in the real values there.
# CATALOG_DB_USER is the login user of the catalog domain: csp-infra-mongo creates it with access only to catalog_db (ADR-006).
# The values of the environment (qa, main) come from the secrets of csp-infra-mongo; never commit them.
CATALOG_DB_NAME=catalog_db
MONGO_HOST=mongodb
CATALOG_DB_USER=change-me
CATALOG_DB_PASSWORD=change-me
